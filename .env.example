# ==============================================================================
# Environment Variables Template - Course Management System & AI Studio
# Copy file này thành ".env" và điền API Key thực tế của bạn (KHÔNG commit .env)
# ==============================================================================

# Google Gemini API (Cloud 1M Context & Zero-Context Baseline)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API (Tùy chọn - chế độ So Sánh Với Claude)
ANTHROPIC_API_KEY=

# OpenAI API (Tùy chọn - dùng cho bước Chưng cất tri thức)
OPENAI_API_KEY=

# OpenRouter API (Tùy chọn - truy cập DeepSeek-V3/R1, Qwen 32B/72B, Llama 70B, Claude, GPT-4o)
OPENROUTER_API_KEY=

# Tùy chọn đường dẫn mô hình Qwen2.5-Coder-3B-Instruct sharded cục bộ & cache HF
# LOCAL_MODEL_PATH=D:\models\Qwen2.5-Coder-3B-Instruct-sharded
# HF_HOME=D:\.cache\huggingface
